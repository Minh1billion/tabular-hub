diff --git a/server/app/worker/heartbeat.py b/server/app/worker/heartbeat.py
index 6a6405b..c5f0c6c 100644
--- a/server/app/worker/heartbeat.py
+++ b/server/app/worker/heartbeat.py
@@ -1,6 +1,6 @@
 import logging
 import threading
-from datetime import datetime, timezone
+from datetime import datetime, timedelta, timezone
 
 from app.config import settings
 from app.database import SessionLocal
@@ -10,6 +10,19 @@ logger = logging.getLogger("app.worker.heartbeat")
 
 LIVE_STATUSES = ("running", "cancelling")
 
+def aware(value: datetime | None) -> datetime | None:
+    if value is not None and value.tzinfo is None:
+        return value.replace(tzinfo=timezone.utc)
+    return value
+
+def has_fresh_heartbeat(run: Run, now: datetime | None = None) -> bool:
+    """True when some worker refreshed this run's heartbeat recently enough to be presumed alive."""
+    beat = aware(run.heartbeat_at)
+    if beat is None:
+        return False
+    now = now or datetime.now(timezone.utc)
+    return beat >= now - timedelta(seconds=settings.RUN_STALE_AFTER_SECONDS)
+
 class RunHeartbeat:
     """Refreshes ``runs.heartbeat_at`` from a background thread while a run executes.
 
diff --git a/server/app/worker/processor.py b/server/app/worker/processor.py
index 5b49e2f..ebe6a33 100644
--- a/server/app/worker/processor.py
+++ b/server/app/worker/processor.py
@@ -11,7 +11,7 @@ from app.core.queue import clear_cancel, is_cancel_requested, publish_event
 from app.database import SessionLocal
 from app.resources.models import ResourceUsage
 from app.run.models import Run, RunEvent
-from app.worker.heartbeat import RunHeartbeat
+from app.worker.heartbeat import RunHeartbeat, has_fresh_heartbeat
 
 logger = logging.getLogger("app.worker.processor")
 
@@ -135,6 +135,13 @@ def process_task(engine_lifecycle: EngineLifecycle, run_id: str, reclaimed: bool
         if run is None or run.status in TERMINAL_STATUSES:
             return True
 
+        if reclaimed and run.status in ("running", "cancelling") and has_fresh_heartbeat(run):
+            # Redelivered while another worker is still alive on it (a long run outlived the
+            # idle window). Leave the message pending instead of executing the run twice;
+            # whichever worker owns the run acks it, or it is re-checked once the heartbeat goes stale.
+            logger.info("run %s is still owned by a live worker, skipping redelivery", run_id)
+            return False
+
         if reclaimed and run.status == "cancelling":
             finalize_run(db, run_id, "cancelled")
             return True
